# Copy to a private .env.demo on the demo host. Do not reuse the developer .env.
# Generate each secret separately with: openssl rand -hex 32
DEMO_DB_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
DEMO_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_SECRET
DEMO_PORT=8793
# For remote demos, set the actual HTTPS URL served by the host's reverse proxy.
DEMO_PUBLIC_BASE_URL=http://localhost:8793
SIGNUP_MODE=closed

# Choose explicitly. Set to crusoe and provide the demo's own API key to exercise it.
REASONING_PROVIDER=fallback
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
REASONING_MODEL=

# Configure these when enabling account sign-in on the demo URL.
AUTHKIT_DOMAIN=
AUTHKIT_ISSUER=
AUTHKIT_AUDIENCE=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
