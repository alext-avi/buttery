# Server (apps/server)
DATABASE_URL=postgres://buttery:buttery@localhost:5433/buttery
TEST_DATABASE_URL=postgres://buttery:buttery@localhost:5433/buttery_test
PORT=8790
PUBLIC_BASE_URL=http://localhost:8790
SESSION_SECRET=replace-with-at-least-32-random-characters
# open: anyone can sign up via AuthKit; closed: only existing users
SIGNUP_MODE=open
# Sign-in codes minted by agents (get_login_code): lifetime in minutes.
LOGIN_CODE_TTL_MINUTES=10
# Set to true behind a reverse proxy (e.g. Caddy on the Vultr demo) so rate limits see the real client IP.
TRUST_PROXY=false
# AuthKit (Task 19)
AUTHKIT_DOMAIN=
AUTHKIT_ISSUER=
AUTHKIT_AUDIENCE=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Reasoning module (packages/reasoning). Copy to .env and fill in; .env is gitignored.
# crusoe | fallback. Default: crusoe when CRUSOE_API_KEY is set, otherwise fallback.
REASONING_PROVIDER=
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Default model for all four functions, plus optional per-function overrides.
REASONING_MODEL=
REASONING_MODEL_CANONICALIZE=
REASONING_MODEL_SHELF_LIFE=
REASONING_MODEL_PARSE=
REASONING_MODEL_RANK=
