{
  "name": "@buttery/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "token:create": "tsx --env-file-if-exists=../../.env src/cli/token-create.ts",
    "e2e:server": "tsx test/e2e-seed.ts && tsx src/main.ts",
    "start:prod": "tsx src/cli/migrate.ts && tsx src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@buttery/domain": "*",
    "@buttery/reasoning": "*",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@workos-inc/node": "^11.0.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
